# この PC だけの設定の雛形。install.ps1 が config.local.env にコピーする（既にあれば触らない）。
# config.local.env は git にも配布用の zip にも入らない。秘密の値（トークン）はここに書く。
# 項目の意味は config.env のコメントを見る。ここに書いた値が config.env の値より優先される。

# --- Colab Manager が画面の選択に合わせて書き換える項目 ---
CONTEXT=262144
MODEL=IQ3_S
HIGH_MEM=0                       # 1 なら High-memory（Colab Pro/Pro+ が必要）
OPEN_BROWSER=0                   # Manager が開くので、スクリプトからはブラウザを開かない
STRATA_EXTRA_ARGS='--mtp on --vision yes'

# --- モデルと GPU ---
MODEL_FAMILY=qwen
ON_GPU_MISMATCH=stop             # A100 以外が割り当てられたら止める（Manager は確認の画面を出せないため）

# --- 秘密の値（自分で書く。空でも動く） ---
# Hugging Face のトークン。モデルの取得が速く・安定する。https://huggingface.co/settings/tokens（取得は Read、下のキャッシュの新規保存も使うなら Write）
HF_TOKEN=
# 変換済み MTP のキャッシュ（約 0.8 GB）。auto なら <トークンのユーザー名>/strata-colab-cache に非公開で作る。
# 2回目以降の起動が速くなる。保存には書き込み権限のあるトークンが要る（空なら HF_TOKEN を使う）。
MTP_CACHE_REPO=auto
MTP_CACHE_TOKEN=
