# strata-colab-cli の設定。各スクリプトが bash で source する。
# API_KEY などの秘密の値は config.local.env に書くと上書きできる。config.local.env は .gitignore 済み。

# ===== Colab ランタイム =====
COLAB_SESSION=strata          # colab CLI のセッション名。ssh_config の ProxyCommand にも渡る
GPU=A100                      # T4 / L4 / G4 / H100 / A100
HIGH_MEM=1                    # 1 なら --high-mem を付ける。Colab Pro/Pro+ が必要
EXPECT_GPU_REGEX='A100'       # nvidia-smi の GPU 名がこれに一致しないときは ON_GPU_MISMATCH に従う
ON_GPU_MISMATCH=ask           # ask: 確認する / stop: ランタイムを止めて終了 / continue: そのまま続行

# ===== Colab VM 側の Strata =====
STRATA_REPO=https://github.com/Niko1221/Strata.git
# 使う Strata の版（コミット）。空なら毎回最新。最新は頻繁に変わり、構成が変わると起動できなくなる
# （2026-11-19、58ee322 で setup.py が terminal/ に移り EXITED）。動作を確かめた版に固定し、上げるときは試してから変える。
# 58ee322（0.2.16 の構成）: 2026-11-19 の実機で、Colab 側の準備は MTP キャッシュなし 715 秒、あり 404 秒。
# 1つ前の固定は 146df3c（2026-11-12、準備まで 480 秒）。
STRATA_REF="${STRATA_REF-58ee3227720629ff2e41d640165ebe89c880dfef}"   # 環境変数 STRATA_REF があればそちら（空なら最新）
MODEL=IQ3_S                   # Strata のサイズ名。Q2_0 / IQ2_XS / IQ3_XXS / IQ3_S / UD-IQ4_XS / UD-Q4_K_XL / UD-Q5_K_XL / UD-Q6_K_XL / Q8_0 など
MODEL_FAMILY=''               # Strata の種類。qwen / swift / coder / unsloth など。空なら Strata の既定

# 公式のセットアップが落とすもの以外の GGUF を Hugging Face から落として使うときに設定する。
# Strata が動かせる形式のファイルだけが使える。ダウンロードの前に setup.sh --inspect で確かめる。
# 非公開のリポジトリなら、HF_TOKEN を config.local.env に書く。
MODEL_REPO=''                 # 例: someone/Qwen3.8-Flash-Next-GGUF。空なら Strata が公式のモデルを落とす
MODEL_FILES=''                # 落とすファイルのパターン。空なら "*<MODEL>*.gguf"。分割された GGUF もまとめて拾える書き方にする
MODEL_REVISION=''             # ブランチ、タグ、コミット。空なら既定のブランチ
CONTEXT=16384
REMOTE_PORT=8089              # Colab VM 側のポート。8080 は Colab が使っていることがある
API_KEY=                      # 空ならキーなし。SSH トンネル経由で手元にだけ出すので通常は不要
STRATA_EXTRA_ARGS=''          # setup.sh に追加で渡す引数。例: --vision yes
REMOTE_DIR=/content/Strata
DATA_DIR=/content/Strata-data # モデルの保存先。ランタイムを止めると消える
REMOTE_LOG=/content/strata-setup.log
# 1 なら、モデルのシャード・画像エンコーダー・MTP の取得を起動直後から並行して進め、SHA-256 の検証と重ねる。
# 取得と検証は Strata 自身の処理を使う。0 なら従来どおり setup.sh が順番に行う
FAST_SETUP=1
# 1 なら、モデルの大きなファイルを strata_fast.py が自前で取得する。受信しながら SHA-256 を計算し (読み直しなし)、O_DIRECT で書いて
# ほかの処理のディスク書き込みを待たせない。照合は Strata の固定値と同じ。想定外のときは Strata の取得に戻る。0 なら Strata の取得
FAST_DOWNLOAD=1
# 1 なら、setup が書く小さなもの (.venv、エンジン、llama.cpp のソース、一時ファイル) を VM のメモリ上 (/dev/shm、約2 GB) に置く。
# シャードがディスクを使い切っている間、普通の書き込みは待たされる (実測: pip の展開 103 秒) ため。0 ならディスクに置く
FAST_SHM=1
TIMELINE_LOG=/content/strata-timeline.log # 各工程の時刻の記録。lib/strata_fast.py --report で表にできる
# 変換済みの MTP (約 0.8 GB) を置く Hugging Face の非公開リポジトリ。初回は取得と変換の後に保存し、次回からは取得と変換の
# 代わりにここから復元する。auto なら <トークンのユーザー名>/strata-colab-cache。無ければ非公開で作る。
# トークンは config.local.env の MTP_CACHE_TOKEN (空なら HF_TOKEN)。保存には書き込み権限が要る。読み取り専用なら復元だけ。
# 空ならキャッシュしない。設定すると Drive より優先する
MTP_CACHE_REPO=''
# 1 なら Google Drive をマウントし、変換済みの MTP (約 0.8 GB) を MyDrive/strata-colab-cache に保存して次回から使う。
# Colab CLI からの Drive の許可は VM ごとで、起動のたびにブラウザでの許可が要る (2026-11-08 確認)。許可がなければ
# キャッシュなしで進む。毎回の手作業を避けるため既定は 0
DRIVE_CACHE=0

# ===== 手元の WSL / Windows =====
STRATA_LANG="${STRATA_LANG:-}" # 表示する言語。空なら自動で、日本語の環境なら ja、それ以外は en。ja か en で固定できる
LOCAL_PORT=8080               # http://localhost:<この番号> で WebUI と API を使う
OPEN_BROWSER=1                # 1 なら起動完了時に Windows のブラウザで WebUI を開く
HEALTH_TIMEOUT_MIN=60         # 起動完了を待つ上限の分数。初回はダウンロードで 20〜30 分かかる。大きいモデルなら増やす
POLL_SEC=20                   # 起動待ちの確認間隔の秒数
SETUP_RETRIES=2               # setup.sh がポート使用中などで落ちたときに Colab 側でやり直す回数
WATCH_SEC=30                  # 起動後に Strata が落ちていないか確認する間隔の秒数
